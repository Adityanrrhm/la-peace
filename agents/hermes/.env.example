# Hermes (Tagira) env — copy to .env and fill real values.
# VPS bootstrap: `cp .env.example .env` then edit.

# Shared with backend .env SERVICE_TOKEN — must match exactly.
TAGIRA_SERVICE_TOKEN=change_me_share_with_backend

# Telegram bot that the Hermes gateway uses to send/receive messages.
TELEGRAM_BOT_TOKEN=
# Owner DM chat id, cron owner report lands here.
TELEGRAM_HOME_CHANNEL=
# Comma-separated telegram user ids allowed to talk to the bot.
TELEGRAM_ALLOWED_USERS=
