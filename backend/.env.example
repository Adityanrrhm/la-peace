# App
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=tagira
DB_PASSWORD=tagira_dev
DB_NAME=tagira
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Auth
SESSION_SECRET=change_me_32_chars_minimum_length
JWT_SECRET=change_me_32_chars_minimum_length_for_jwt
